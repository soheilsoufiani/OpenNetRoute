<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests exercise the real networking stack (local SOCKS5 test server,
       WinDivert packet capture, process-to-connection mapping). They must clean up
       after themselves and never require a real external proxy. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProxyApp.Core\ProxyApp.Core.csproj" />
    <ProjectReference Include="..\..\src\ProxyApp.Network\ProxyApp.Network.csproj" />
    <ProjectReference Include="..\..\src\ProxyApp.Processes\ProxyApp.Processes.csproj" />
    <ProjectReference Include="..\..\src\ProxyApp.WinDivert\ProxyApp.WinDivert.csproj" />
  </ItemGroup>

</Project>