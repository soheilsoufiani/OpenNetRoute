<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-independent business logic: configuration models, rules,
       routing decisions, validation, interfaces. Intentionally no Windows-specific code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test visibility: the legacy-settings migration helper is internal —
         unit tests drive it with explicit paths because the parameterless
         constructor reads the real %APPDATA% location. -->
    <InternalsVisibleTo Include="ProxyApp.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency justification (AGENTS.md rule 3): first-party Microsoft
         package (MIT), required for DPAPI credential protection at rest
         (SecretProtector). The problem — storing proxy passwords without
         plaintext on disk — cannot be solved portably without it; plaintext
         was rejected as a security regression. On platforms without DPAPI the
         SecretProtector degrades gracefully to marked base64. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
