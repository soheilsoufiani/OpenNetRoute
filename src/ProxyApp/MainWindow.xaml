<Window x:Class="ProxyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProxyApp"
        mc:Ignorable="d"
        Title="Open NetRoute" Icon="/Assets/app.ico" Height="720" Width="720" MinHeight="560" MinWidth="640"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Modern.xaml"/>
    </Window.Resources>

    <!-- Root: tabbed workspace + persistent bottom action bar -->
    <Grid Background="{DynamicResource BgWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Style="{StaticResource FlatTabs}"
                    Margin="14,10,14,0">

            <!-- ═══ TAB: PROXIES ═══ -->
            <TabItem Header="Proxies">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="SOCKS5 proxy profiles"/>

                                <!-- Top row: create/import + list-wide actions
                                     (all list actions live here so every card
                                     stays clean: Edit / Share / Delete only). -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="NewProxyButton" Content="New…"
                                            ToolTip="Create a new proxy profile"
                                            Click="OnNewProxyClicked"/>
                                    <Button x:Name="PasteProxyButton" Content="Paste Config" Margin="6,0,0,0"
                                            ToolTip="Paste a socks5:// URL from the clipboard (Ctrl+V) — socks5://host:port or socks5://user:pass@host:port (user/pass optional)"
                                            Click="OnPasteConfigClicked"/>
                                    <Button x:Name="PingAllButton" Content="Test Ping" Margin="14,0,0,0"
                                            ToolTip="Real ping: SOCKS5 handshake + CONNECT through every profile (5 s timeout each)"
                                            Click="OnTestPingClicked"/>
                                    <Button x:Name="SortByPingButton" Content="Sort: Fastest" Margin="6,0,0,0"
                                            ToolTip="Order profiles by last ping — fastest first (untested and failed last)"
                                            Click="OnSortByPingClicked"/>
                                    <Button x:Name="DeleteAllProxyButton" Content="Delete All" Margin="6,0,0,0"
                                            ToolTip="Delete every saved profile (asks for confirmation)"
                                            Click="OnDeleteAllProxiesClicked"/>
                                    <Button x:Name="RestartServicesButton" Content="Restart" Margin="6,0,0,0"
                                            ToolTip="Restart services: stop the engine if running, then start it again with the selected profile"
                                            Click="OnRestartServicesClicked"/>
                                </StackPanel>

                                <!-- Profile cards (v2rayNG-style): config name on
                                     top, host:port underneath, auth line below
                                     that, ping spot on the right, and per-card
                                     Edit / Share / Delete. Click a card body to
                                     make it the profile START routes through. -->
                                <ItemsControl x:Name="ProfileCardList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Tag="{Binding}"
                                                    MouseLeftButtonUp="OnProxyCardClicked">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                        <Setter Property="Padding" Value="12,10,10,10"/>
                                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                                        <Style.Triggers>
                                                            <!-- No Hand cursor: the card is a large
                                                                 surface and the arrow must stay normal
                                                                 outside real buttons. The hover tint
                                                                 keeps the click-to-select affordance.
                                                                 IsMouseOver is listed BEFORE IsSelected
                                                                 so a hovered selected card keeps its
                                                                 selection background. -->
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource HoverTintBrush}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Line 1: config name (semibold);
                                                         line 2: host : port (normal);
                                                         line 3: protocol/auth (italic). -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Config.Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding EndpointDisplay}"
                                                                   FontSize="11" FontWeight="Normal"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DetailsDisplay}"
                                                                   FontSize="10.5" FontWeight="Normal" FontStyle="Italic"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Ping spot: last real-ping result
                                                         (tooltip = full outcome text). -->
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                               Margin="10,0,6,0"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Text="{Binding PingDisplay}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Setter Property="ToolTip" Value="{Binding PingDetails}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PingDetails}" Value="">
                                                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PingTone}" Value="Good">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PingTone}" Value="Slow">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PingTone}" Value="Bad">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Per-card actions (Edit / Copy / Delete) as
                                                         quiet icon buttons on the shared ChipIcon
                                                         style: light gray at rest, white on hover.
                                                         Rounded line icons (stroke paths, round
                                                         caps/joins); the stroke binds to the
                                                         button's Foreground, so the gray→white
                                                         states apply to the icon itself. -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource ChipIcon}"
                                                                ToolTip="Edit this profile"
                                                                Tag="{Binding}" Click="OnEditProxyClicked">
                                                            <Path Data="M12.03,2.02C11.54,2.02,11.07,2.27,10.68,2.66L2.56,10.73,1.21,14.79,5.27,13.43,5.35,13.35,13.39,5.37C13.77,4.98,14.02,4.51,14.02,4.01,14.02,3.52,13.77,3.05,13.39,2.66,13,2.27,12.53,2.02,12.03,2.02ZM10.03,4.71,11.32,6.01,4.73,12.56,2.79,13.21,3.44,11.27Z"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="13" Height="13" Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource ChipIcon}" Margin="4,0,0,0"
                                                                ToolTip="Copy this profile as a socks5:// URL (includes credentials — paste it into Paste Config on another machine)"
                                                                Tag="{Binding}" Click="OnShareProxyClicked">
                                                            <Path Data="M12.5,1C11.13,1,10,2.13,10,3.5,10,3.67,10.02,3.84,10.05,4L5.52,6.04C5.06,5.41,4.33,5,3.5,5,2.13,5,1,6.13,1,7.5,1,8.88,2.13,10,3.5,10,4.33,10,5.07,9.58,5.53,8.95L10.06,10.96C10.02,11.14,10,11.32,10,11.5,10,12.88,11.13,14,12.5,14,13.88,14,15,12.88,15,11.5,15,10.13,13.88,9,12.5,9,11.67,9,10.93,9.42,10.47,10.05L5.94,8.04C5.98,7.86,6,7.68,6,7.5,6,7.31,5.98,7.13,5.94,6.95L10.45,4.91C10.9,5.57,11.65,6,12.5,6,13.88,6,15,4.88,15,3.5,15,2.13,13.88,1,12.5,1ZM12.5,2C13.34,2,14,2.66,14,3.5,14,4.34,13.34,5,12.5,5,11.66,5,11,4.34,11,3.5,11,2.66,11.66,2,12.5,2ZM3.5,6C4.34,6,5,6.66,5,7.5,5,8.34,4.34,9,3.5,9,2.66,9,2,8.34,2,7.5,2,6.66,2.66,6,3.5,6ZM12.5,10C13.34,10,14,10.66,14,11.5,14,12.34,13.34,13,12.5,13,11.66,13,11,12.34,11,11.5,11,10.66,11.66,10,12.5,10Z"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="13" Height="13" Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource ChipIcon}" Margin="4,0,0,0"
                                                                ToolTip="Delete this profile"
                                                                Tag="{Binding}" Click="OnDeleteProxyClicked">
                                                            <Path Data="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  Width="13" Height="13" Stretch="Uniform"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="EmptyProxyHint" Style="{StaticResource Hint}" Margin="0,4,0,2" TextWrapping="Wrap"
                                           Text="No proxy profiles yet — use New… or Paste Config."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: APP RULES ═══ -->
            <TabItem Header="App Rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Application rules"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="Assign applications to the tunnel. Running-process selections are managed in the picker; manual exe rules and folder bundles are managed here. Each rule can pin its own proxy profile in the ROUTE column (or use the active proxy)."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button x:Name="AddProcessesButton" Content="Add Running Processes…"
                                            Style="{DynamicResource AccentButton}" MinWidth="200" MinHeight="32"
                                            ToolTip="Open the running-processes picker"
                                            Click="OnOpenProcessesClicked"/>
                                    <Button x:Name="AddExeButton" Content="Add EXE…" MinHeight="32"
                                            Margin="8,0,0,0" Click="OnAddExeClicked"/>
                                    <Button x:Name="AddFolderButton" Content="Add Folder…" MinHeight="32"
                                            Margin="8,0,0,0" Click="OnAddFolderClicked"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Manual executable rules" Margin="0,18,0,10"/>
                                <!-- Horizontal scrolling is disabled and the PATH
                                     column is stretched by code-behind, so long paths
                                     trim with an ellipsis and the ✕ button always stays
                                     reachable. Clicking a path copies it. Fixed widths:
                                     EXECUTABLE 130 (icon + ~16 chars, hover shows the
                                     full name) + PATH 330 (stretched) + ROUTE 130
                                     + remove 44 — together they fit the default
                                     window's list width so ROUTE and ✕ stay visible. -->
                                <Grid>
                                <ListView x:Name="ManualRuleList" MinHeight="72" Style="{StaticResource DataList}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SizeChanged="OnManualRuleListSizeChanged">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False">
                                            <GridViewColumn Header="EXECUTABLE" Width="130">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- The exe's extracted icon behind the name;
                                                             placeholder glyph for name-only rules and
                                                             unreadable paths (empty IconSource). The name
                                                             trims at the ~16-character column width and the
                                                             tooltip reveals the full name. A row routed as
                                                             Disabled is dimmed and struck through. -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="14" Height="14"
                                                                   Source="{Binding IconSource, TargetNullValue={x:Static local:ManualRuleIconCache.PlaceholderIconSource}}"
                                                                   VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ExecutableName}"
                                                                       Margin="6,0,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip="{Binding ExecutableName}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource TextPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                <Setter Property="Foreground"
                                                                                        Value="{DynamicResource TextSecondaryBrush}"/>
                                                                                <Setter Property="TextDecorations"
                                                                                        Value="Strikethrough"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn x:Name="ManualRulePathColumn" Header="PATH" Width="330">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- No Hand cursor: the cursor must stay the normal
                                                             arrow outside real buttons. The cell remains
                                                             click-to-copy; the tooltip says so. -->
                                                        <TextBlock Text="{Binding PathDisplay}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Background="Transparent"
                                                                   ToolTip="{Binding PathToolTip}"
                                                                   ToolTipService.InitialShowDelay="300"
                                                                   MouseLeftButtonUp="OnCopyPathTextClicked"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="ROUTE" Width="130">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- One compact combo at the right edge of the
                                                             list for everything: Disabled (rule
                                                             inactive — dimmed + struck through), Direct
                                                             (pass through outside the proxy), Default
                                                             Proxy (the active proxy on the Proxies tab),
                                                             a non-selectable separator, one entry per
                                                             saved proxy profile (pinning it for this
                                                             rule). Persisted as Enabled / Mode /
                                                             ProxyName. -->
                                                        <ComboBox ItemsSource="{x:Static local:RouteChoiceRow.SharedRouteChoices}"
                                                                  SelectedIndex="{Binding ModeIndex}"
                                                                  SelectionChanged="OnRouteComboSelectionChanged" MinWidth="118" MinHeight="22" FontSize="11"
                                                                  ToolTip="Disabled = rule inactive — Direct = pass through outside the proxy — Default Proxy = the active proxy selected on the Proxies tab — pick a profile to pin it for this rule">
                                                            <ComboBox.ItemContainerStyle>
                                                                <Style TargetType="ComboBoxItem"
                                                                       BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding}"
                                                                                     Value="{x:Static local:RouteChoiceRow.RouteSeparator}">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.ItemContainerStyle>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="" Width="44">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- Quiet icon button (the same ChipIcon style the
                                                             proxy config cards use): transparent until
                                                             hover, then the themed tint + accent glyph in
                                                             light and dark — instead of a heavy bordered
                                                             button competing with the row's controls.
                                                             22px so the click target fits the taller row. -->
                                                        <Button Style="{StaticResource ChipIcon}"
                                                                Content="✕"
                                                                Width="22" Height="22" FontSize="10"
                                                                ToolTip="Remove this rule"
                                                                Click="OnRemoveManualRuleClicked"
                                                                Tag="{Binding}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!-- Empty-state hint: visible while the manual rules
                                     list has no rows. Sits on the list's second row
                                     line instead of dead-center. -->
                                <TextBlock x:Name="EmptyRulesHint"
                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                           Margin="0,40,0,0"
                                           Style="{StaticResource Hint}" TextAlignment="Center"
                                           Visibility="Collapsed"
                                           Text="The rules list is empty — add running processes, an EXE, or a folder bundle above."/>
                                </Grid>

                                <!-- Hidden while there are no bundles — with the
                                     chips list empty the whole section collapses. -->
                                <StackPanel x:Name="BundleHeaderPanel" Orientation="Horizontal"
                                            Margin="0,18,0,6" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SectionTitle}"
                                               Text="Folder bundles"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="10,1,0,0"
                                               Text="Shift+click a bundle to open its details"/>
                                </StackPanel>
                        <ItemsControl x:Name="BundleList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ChipRoot"
                                            Style="{StaticResource BundleChip}"
                                            MouseLeftButtonUp="OnBundleChipClicked"
                                            ToolTip="Click: enable / disable — Shift+click: details">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        ToolTip="{Binding FolderPath}">
                                                <!-- Folder glyph ahead of the bundle name
                                                     (Segoe MDL2 Assets folder icon). The name
                                                     caps at ~8 characters and trims with an
                                                     ellipsis; the tooltip shows the full path. -->
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE8B7;"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           MaxWidth="48"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextSecondaryBrush}"/>
                                                                    <Setter Property="TextDecorations"
                                                                            Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel x:Name="ChipTools" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,3,3,0"
                                                        Visibility="Hidden" Background="Transparent">
                                                <Button Style="{StaticResource ChipIcon}" Content="✕"
                                                        FontSize="9"
                                                        ToolTip="Remove this bundle"
                                                        Click="OnRemoveBundleClicked" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ChipTools" Property="Visibility"
                                                    Value="Visible"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter TargetName="ChipRoot" Property="Opacity"
                                                    Value="0.55"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: IP / DOMAIN RULES ═══ -->
            <TabItem Header="IP/Domain Rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="IP &amp; domain routing rules"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           Text="Destination rules — evaluated BEFORE the App Rules, so per-destination intent overrides an app-wide pin. MATCH is an IPv4 address or a domain, optionally with a port (1.2.3.4, 1.2.3.4:443, example.com, example.com:8443). Fields are locked: click Edit to type, then Save (or Cancel to discard). IPv6 destinations never match; a domain is resolved through DNS at connection time (cached) — DoH/DoT applications bypass it."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button x:Name="AddIpDomainRuleButton" Content="Add IP or Domain…"
                                            Style="{DynamicResource AccentButton}" MinWidth="200" MinHeight="32"
                                            ToolTip="Add a destination rule row — type the IP or domain in the MATCH cell"
                                            Click="OnAddIpDomainRuleClicked"/>
                                </StackPanel>

                                <Grid>
                                    <ListView x:Name="IpDomainRuleList" MinHeight="72" Style="{StaticResource DataList}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              SizeChanged="OnIpDomainListSizeChanged">
                                        <ListView.View>
                                        <GridView AllowsColumnReorder="False">
                                            <GridViewColumn x:Name="IpDomainMatchColumn" Header="MATCH" Width="180">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- Typed match: IPv4 or domain, optional
                                                             ':port'. LOCKED (read-only) until the row's
                                                             Edit button unlocks it; Save commits and
                                                             re-locks, Cancel restores. The field STRETCHES
                                                             to fill the MATCH column (stretched by
                                                             code-behind so no dead space remains after the
                                                             tools); accent border while unlocked. -->
                                                        <TextBox Text="{Binding MatchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinHeight="22" FontSize="11"
                                                                 Padding="4,0" VerticalContentAlignment="Center"
                                                                 ToolTip="IPv4 address or domain, optionally ':port' — e.g. 1.2.3.4, 1.2.3.4:443, example.com, example.com:8443">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox"
                                                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                                                    <Setter Property="IsReadOnly" Value="True"/>
                                                                    <Setter Property="BorderBrush"
                                                                            Value="{DynamicResource InputBorderBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                            <Setter Property="IsReadOnly" Value="False"/>
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                        <!-- Red border wins over the accent while
                                                                             editing: the text failed Save's
                                                                             validation and was NOT committed. -->
                                                                        <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="{DynamicResource DangerBrush}"/>
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource TextSecondaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                                <GridViewColumn Header="ROUTE" Width="130">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <!-- Same merged ROUTE combo as the manual
                                                                 exe rules: Disabled, Direct, Default
                                                                 Proxy, separator, saved profiles. -->
                                                            <ComboBox ItemsSource="{x:Static local:RouteChoiceRow.SharedRouteChoices}"
                                                                      SelectedIndex="{Binding ModeIndex}"
                                                                      SelectionChanged="OnRouteComboSelectionChanged" MinWidth="118" MinHeight="22" FontSize="11"
                                                                      ToolTip="Disabled = rule inactive — Direct = pass through outside the proxy — Default Proxy = the active proxy selected on the Proxies tab — pick a profile to pin it for this rule">
                                                                <ComboBox.ItemContainerStyle>
                                                                    <Style TargetType="ComboBoxItem"
                                                                           BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}"
                                                                                         Value="{x:Static local:RouteChoiceRow.RouteSeparator}">
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ComboBox.ItemContainerStyle>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="" Width="160">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <!-- Row tools at the right edge, next to the
                                                                 ROUTE selector. Self-explanatory at first
                                                                 glance: while LOCKED a single muted "Edit"
                                                                 link shows; while UNLOCKED (accent-bordered
                                                                 MATCH cell) it becomes an accent "Save" plus
                                                                 a muted "Cancel" — the labels say what they
                                                                 do. Same quiet ChipIcon look as the proxy
                                                                 cards; ✕ removes the row in either state. -->
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="Edit"
                                                                        FontSize="11" MinHeight="22" MinWidth="40"
                                                                        ToolTip="Unlock this rule's MATCH field for typing"
                                                                        Click="OnEditIpDomainRuleClicked"
                                                                        Tag="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button"
                                                                               BasedOn="{StaticResource ChipIcon}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="Save"
                                                                        FontSize="11" MinHeight="22" MinWidth="40"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource AccentBrush}"
                                                                        ToolTip="Save the new address/domain and lock the field"
                                                                        Click="OnSaveIpDomainRuleClicked"
                                                                        Tag="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button"
                                                                               BasedOn="{StaticResource ChipIcon}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="Cancel"
                                                                        FontSize="11" MinHeight="22" MinWidth="40"
                                                                        ToolTip="Discard the edit and lock the field"
                                                                        Click="OnCancelIpDomainRuleClicked"
                                                                        Tag="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button"
                                                                               BasedOn="{StaticResource ChipIcon}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Style="{StaticResource ChipIcon}"
                                                                        Content="✕"
                                                                        Margin="4,0,0,0"
                                                                        Width="22" Height="22" FontSize="10"
                                                                        ToolTip="Remove this rule"
                                                                        Click="OnRemoveIpDomainRuleClicked"
                                                                        Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <!-- Empty-state hint: visible while the IP/domain
                                         list has no rows. -->
                                    <TextBlock x:Name="EmptyIpDomainHint"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,40,0,0"
                                               Style="{StaticResource Hint}" TextAlignment="Center"
                                               Visibility="Collapsed"
                                               Text="No IP or domain rules yet — use Add IP or Domain… above."/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: DATA USAGE ═══ -->
            <TabItem Header="Data Usage">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="0,0,0,16">

                        <!-- ── Live (current session) ── -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Live — current session"/>
                                <TextBlock x:Name="UsageActiveProfileHint" Style="{StaticResource Hint}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Tracking starts the moment you press START."/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="UpSpeedText" Text="0 B/s"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="▲ upload" Style="{StaticResource Hint}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="DownSpeedText" Text="0 B/s"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="▼ download" Style="{StaticResource Hint}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TotalSpeedText" Text="0 B/s"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Σ total" Style="{StaticResource Hint}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SessionTotalsText" Style="{StaticResource Hint}"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Text="This session: 0 B up, 0 B down (0 B total)."/>
                            </StackPanel>
                        </Border>

                        <!-- ── History (per configuration, all sessions) ── -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="History — per configuration"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Cumulative traffic per proxy configuration across all sessions (merged live with the running session). Counters are keyed by the configuration's name."/>
                                <Grid>
                                    <ListView x:Name="UsageHistoryList" MinHeight="72" Style="{StaticResource DataList}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="False">
                                                <GridViewColumn Header="CONFIGURATION" Width="200">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource TextPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOverall}" Value="True">
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="UPLOADED" Width="130">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding UpDisplay}"
                                                                       HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="DOWNLOADED" Width="130">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DownDisplay}"
                                                                       HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="TOTAL" Width="130">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TotalDisplay}"
                                                                       HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <TextBlock x:Name="EmptyUsageHint"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,60,0,0"
                                               Style="{StaticResource Hint}" TextAlignment="Center"
                                               Visibility="Collapsed"
                                               Text="No usage recorded yet — history appears after the first START with traffic."/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: SETTINGS ═══ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="0,0,0,16">

                        <!-- ── DNS ── -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="DNS"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Stops your apps' DNS queries from leaking out direct while the proxy runs."/>
                                <CheckBox x:Name="DnsRelayCheck" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          Content="Relay DNS through the proxy (all apps — closes the DNS leak)"
                                          Checked="OnDnsPrefChanged" Unchecked="OnDnsPrefChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,8">
                                    <TextBlock Text="Relayed queries go to:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="DnsResolverCombo" Width="260" MinHeight="30"
                                              SelectionChanged="OnDnsPrefChanged"
                                              ToolTip="Relayed queries are sent to this resolver through the proxy. A public resolver keeps your ISP's DNS out of the path — leak tests then show it instead of your ISP. 'Transparent' forwards each query to the DNS server the app originally addressed.">
                                        <ComboBoxItem Content="Cloudflare (1.1.1.1) — recommended"/>
                                        <ComboBoxItem Content="Google (8.8.8.8)"/>
                                        <ComboBoxItem Content="Quad9 (9.9.9.9)"/>
                                        <ComboBoxItem Content="Transparent (each app's own DNS server)"/>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="StunRelayCheck" HorizontalAlignment="Left" Margin="16,0,0,8"
                                          Content="Also relay STUN traffic (WebRTC shows the proxy's IP)"
                                          Checked="OnDnsPrefChanged" Unchecked="OnDnsPrefChanged"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="Intercepts ALL outbound DNS (UDP 53, IPv4) system-wide and relays it through the active proxy (SOCKS5 UDP ASSOCIATE) — Windows sends app DNS from its DNS cache service (svchost), so this cannot be limited to selected apps. Applies at the next START. If your proxy does not support UDP, system DNS will fail while this is on — disable it or enable UDP in your proxy."/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Still NOT covered: browsers/apps with their own secure DNS (DoH/DoT) and DNS over IPv6 transport."/>
                            </StackPanel>
                        </Border>

                        <!-- ── Appearance ── -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Appearance"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="How the app looks."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Theme:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ThemeCombo" Width="140" MinHeight="30"
                                              SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="System"/>
                                        <ComboBoxItem Content="Light"/>
                                        <ComboBoxItem Content="Dark"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="&quot;System&quot; follows the Windows personalization setting at the next launch."/>
                            </StackPanel>
                        </Border>

                        <!-- ── Automation ── -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Automation"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Let the app check proxies for you."/>
                                <CheckBox x:Name="TestOnSaveCheck" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          Content="Test proxy on save"
                                          Checked="OnTestPrefChanged" Unchecked="OnTestPrefChanged"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="Runs a SOCKS5 handshake + CONNECT test after a profile is added or edited. Also available via the profile editor's Test button."/>
                            </StackPanel>
                        </Border>

                        <!-- ── Tunnel optimization ── -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Tunnel optimization"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Performance and latency tuning of the packet engine. Applies at the next START."/>
                                <CheckBox x:Name="AutoMtuCheck" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          Content="Automatic MTU (probe the path, adapt the advertised MSS)"
                                          ToolTip="At START the engine measures the largest packet size that survives the path (interface MTU + don't-fragment pings) and lowers the advertised MSS accordingly — prevents fragmentation stalls on small-MTU paths."
                                          Checked="OnOptimizationPrefChanged" Unchecked="OnOptimizationPrefChanged"/>
                                <CheckBox x:Name="GameModeCheck" HorizontalAlignment="Left"
                                          Content="Game Mode (low-latency packets: DSCP EF + MSS 1360)"
                                          ToolTip="Marks injected packets with DSCP Expedited Forwarding (priority queuing on routers that honor it) and clamps the advertised MSS to 1360 — TunnelX-style low-latency tuning."
                                          Checked="OnOptimizationPrefChanged" Unchecked="OnOptimizationPrefChanged"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="With Game Mode on, the relayed DNS resolver preference is unchanged (Cloudflare is already the fastest default)."/>
                            </StackPanel>
                        </Border>

                        <!-- ── Tray & startup ── -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Tray icon &amp; startup"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Run quietly in the background and launch with Windows."/>
                                <CheckBox x:Name="TrayEnabledCheck" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          Content="Show tray icon (notification area)"
                                          ToolTip="Notification-area icon with Open, Start/Stop routing, live status and Exit. Enables close-to-tray and minimize-to-tray."
                                          Checked="OnTrayPrefChanged" Unchecked="OnTrayPrefChanged"/>
                                <CheckBox x:Name="StartMinimizedCheck" HorizontalAlignment="Left" Margin="16,0,0,8"
                                          Content="Start minimized to the tray (next launch)"
                                          ToolTip="The next launch shows no window — only the tray icon. Requires the tray icon."
                                          Checked="OnTrayPrefChanged" Unchecked="OnTrayPrefChanged"/>
                                <CheckBox x:Name="MinimizeToTrayCheck" HorizontalAlignment="Left" Margin="16,0,0,8"
                                          Content="Minimize to the tray instead of the taskbar"
                                          ToolTip="The minimize button hides the window; the tray icon restores it. Requires the tray icon."
                                          Checked="OnTrayPrefChanged" Unchecked="OnTrayPrefChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,8">
                                    <TextBlock Text="Close (X) button:"
                                               Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CloseBehaviorCombo" Width="260" MinHeight="30"
                                              SelectionChanged="OnCloseBehaviorChanged">
                                        <ComboBoxItem Content="Hide to the tray (keep routing)"/>
                                        <ComboBoxItem Content="Exit the application"/>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartCheck" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          Content="Start Open NetRoute when Windows signs in (current user)"
                                          ToolTip="Registers the current executable under HKCU\Software\Microsoft\Windows\CurrentVersion\Run. The window/tray behavior of that launch follows the settings above."
                                          Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="With the tray icon on, the engine keeps routing while the window is hidden — Exit lives in the tray menu. With it off, Close always exits and minimize uses the taskbar."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: HELP ═══ -->
            <TabItem Header="Help">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="0,0,0,16">

                        <!-- Single help card: banner, about + GitHub, then every
                             subject as an Expander (collapsed except the first)
                             so the tab stays compact until a subject is opened. -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Image Source="/Assets/banner.png" Stretch="Uniform"
                                       MaxHeight="180" Margin="0,0,0,12"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="About Open NetRoute"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10">
                                    Selective application routing for Windows through SOCKS5 proxies. It routes
                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">only the applications you choose</Run>
                                    through the proxy — everything else keeps using the normal Windows connection.
                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">No VPN interface, no routing-table changes.</Run>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Hyperlink NavigateUri="https://github.com/soheilsoufiani/OpenNetRoute"
                                               RequestNavigate="OnHelpLinkNavigate"
                                               ToolTip="Open the Open NetRoute repository on GitHub">
                                        GitHub: github.com/soheilsoufiani/OpenNetRoute
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Get releases, report issues, and read the docs there. Open NetRoute is MIT licensed (Beta)."/>

                                <Expander Header="How it works" IsExpanded="True" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,6,0,0" FontWeight="Normal">
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Selected App → Open NetRoute → SOCKS5 Proxy → Internet.</Run>
                                        Open NetRoute watches outbound traffic
                                        (<Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">WinDivert, administrator required</Run>),
                                        checks which application each connection belongs to, and forwards the selected ones through your SOCKS5 proxy.
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Unselected applications pass through directly.</Run>
                                    </TextBlock>
                                </Expander>

                                <Expander Header="Proxies tab" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,6,0,0" FontWeight="Normal">
                                        SOCKS5 proxy profiles.
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Click a card to make it the active profile that START routes through.</Run>
                                        New… creates a profile; Paste Config imports a socks5:// URL; Test Ping checks every profile (handshake + CONNECT, 5 s timeout);
                                        Sort: Fastest orders by last ping; Delete All removes all profiles; Restart restarts the engine with the selected profile.
                                        Per-card buttons: Edit, Share (copy as socks5:// URL), Delete.
                                    </TextBlock>
                                </Expander>

                                <Expander Header="App Rules tab" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,6,0,0" FontWeight="Normal">
                                        Which applications use the tunnel. Add Running Processes… (picker), Add EXE… (single file), or Add Folder…
                                        (folder bundle covering every .exe under it, including ones added later).
                                        Each manual rule has a
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">ROUTE</Run>
                                        combo:
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Disabled</Run> (rule off),
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Direct</Run> (bypass the proxy),
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Default Proxy</Run> (the active Proxies-tab profile),
                                        or a pinned saved profile. Click a PATH cell to copy it. Click a bundle chip to enable/disable; Shift+click for details.
                                    </TextBlock>
                                </Expander>

                                <Expander Header="IP/Domain Rules tab" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,6,0,0" FontWeight="Normal">
                                        Destination rules, evaluated
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">BEFORE App Rules</Run>
                                        — a per-destination choice wins over an app-wide pin.
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">MATCH</Run>
                                        is an IPv4 address or domain with optional :port (1.2.3.4, 1.2.3.4:443, example.com, example.com:8443).
                                        Fields are locked: click Edit to type, then Save (Cancel discards). Same ROUTE choices as App Rules.
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">IPv6 destinations never match;</Run>
                                        domains resolve at connection time. Apps with their own encrypted DNS (DoH/DoT) bypass domain matching.
                                    </TextBlock>
                                </Expander>

                                <Expander Header="Data Usage tab" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,6,0,0" FontWeight="Normal">
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Live</Run>
                                        shows current-session upload / download / total speeds plus session totals (tracking starts at START).
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">History</Run>
                                        shows cumulative traffic per proxy configuration across all sessions, merged live with the running session.
                                    </TextBlock>
                                </Expander>

                                <Expander Header="Settings tab" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <StackPanel Margin="16,6,0,0">
                                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="Normal">
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">DNS:</Run>
                                            relay supported DNS (UDP 53, IPv4)
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">system-wide</Run>
                                            through the proxy via
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">SOCKS5 UDP ASSOCIATE</Run>
                                            — cannot be limited to selected apps. Pick the resolver relayed queries go to, optionally relay STUN for WebRTC.
                                            Applies at <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">next START</Run>;
                                            disable if your proxy lacks UDP support. Not covered: DoH/DoT, custom resolvers, IPv6 DNS.
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="Normal">
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Appearance:</Run>
                                            Light / Dark / System theme.
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Automation:</Run>
                                            test proxy on save.
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Tunnel optimization:</Run>
                                            Automatic MTU and Game Mode (low-latency tuning), applied at next START.
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" FontWeight="Normal">
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Tray icon &amp; startup:</Run>
                                            tray icon with Open / Start-Stop / Exit, start minimized, minimize-to-tray, Close-button behavior, and launch with Windows sign-in.
                                        </TextBlock>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Bottom bar, Debug &amp; tray" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,6,0,0" FontWeight="Normal">
                                        The bottom bar is always visible:
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Status</Run> text plus the
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Debug</Run> button (full session log window)
                                        and the <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">START/STOP</Run> toggle.
                                        The tray icon (when enabled) keeps routing while the window is hidden — Exit lives in the tray menu.
                                    </TextBlock>
                                </Expander>

                                <Expander Header="Quick Start" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,6,0,0" FontWeight="Normal">
                                        1.
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Run as administrator.</Run>
                                        2. Proxies tab: add a profile, Test Ping. 3. App Rules tab: add the app to route.
                                        4. Optional: IP/Domain Rules for finer control. 5. Settings: check DNS relay.
                                        6. Press <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">START</Run>.
                                        7. Data Usage: confirm traffic; Debug: investigate problems.
                                    </TextBlock>
                                </Expander>

                                <Expander Header="Requirements &amp; limitations" Margin="0,2,0,2"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,6,0,0" FontWeight="Normal">
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Windows 10/11 x64, administrator rights</Run>
                                        (WinDivert needs them). Beta: partial IPv6 / QUIC / UDP coverage, no DoH/DoT handling, no guaranteed leak-proof DNS.
                                        Antivirus/firewalls may interfere with traffic interception. Test what matters to you before relying on it.
                                    </TextBlock>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Persistent bottom action bar (engine controls visible on every tab) -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           TextWrapping="Wrap" Text="Status: Stopped"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DebugButton" Content="Debug" MinWidth="84" Margin="0,0,8,0"
                            ToolTip="Open the session debug log window (complete history since launch)"
                            Click="OnDebugClicked"/>
                    <ToggleButton x:Name="EngineToggleButton"
                                  Style="{DynamicResource StateToggleButton}"
                                  ToolTip="Start or stop the tunnel engine"
                                  Checked="OnEngineToggleChecked"
                                  Unchecked="OnEngineToggleUnchecked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>


