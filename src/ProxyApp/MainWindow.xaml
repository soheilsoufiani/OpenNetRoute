<Window x:Class="ProxyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MyProxy" Height="720" Width="720" MinHeight="560" MinWidth="640">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SOCKS5 Proxy configuration -->
        <GroupBox Grid.Row="0" Header="SOCKS5 Proxy" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="ProxyHostBox" Grid.Row="0" Grid.Column="1" Margin="0,0,12,4"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="ProxyPortBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,4" Text="1080"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="ProxyUsernameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Password:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <PasswordBox x:Name="ProxyPasswordBox" Grid.Row="1" Grid.Column="3"/>
            </Grid>
        </GroupBox>

        <!-- Applications / rules -->
        <GroupBox Grid.Row="1" Header="Applications" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search + actions row -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="OnSearchTextChanged"
                             ToolTip="Filter by process name, path, or bundle name"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="AddExeButton" Content="Add EXE..." Margin="6,0,0,0" Padding="10,2" Click="OnAddExeClicked"/>
                        <Button x:Name="AddFolderButton" Content="Add Folder..." Margin="6,0,0,0" Padding="10,2" Click="OnAddFolderClicked"/>
                        <Button x:Name="RefreshButton" Content="Refresh" Margin="6,0,0,0" Padding="10,2" Click="OnRefreshClicked"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="Select applications to route. Leave unchecked for Direct."
                           VerticalAlignment="Center" Margin="0,0,0,4" Foreground="Gray"/>

                <!-- Unified scrollable rules area: process rows + manual rules + bundles -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                    <StackPanel>
                        <!-- Running processes -->
                        <TextBlock Text="Running processes" FontWeight="SemiBold" Margin="0,2,0,2"/>
                        <ListView x:Name="ProcessList" Height="160" BorderThickness="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Route" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding RouteViaProxy}"
                                                          ToolTip="Route through the SOCKS5 proxy"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Process" Width="180"
                                                    DisplayMemberBinding="{Binding ProcessName}"/>
                                    <GridViewColumn Header="Path" Width="300"
                                                    DisplayMemberBinding="{Binding ProcessPath}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Manual exe rules -->
                        <TextBlock Text="Manual rules" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        <ListView x:Name="ManualRuleList" Height="Auto" MaxHeight="140" BorderThickness="1"
                                  ItemsSource="{Binding}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Route" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled}"
                                                          ToolTip="Route through the SOCKS5 proxy"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Executable" Width="200"
                                                    DisplayMemberBinding="{Binding ExecutableName}"/>
                                    <GridViewColumn Header="Path" Width="280"
                                                    DisplayMemberBinding="{Binding ExecutablePath}"/>
                                    <GridViewColumn Header="" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" FontSize="10" Padding="4,0"
                                                        Click="OnRemoveManualRuleClicked"
                                                        Tag="{Binding}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Folder bundles -->
                        <TextBlock Text="Folder bundles" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        <ItemsControl x:Name="BundleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding DisplayName}" Margin="0,0,0,4">
                                        <StackPanel Margin="16,4,0,4">
                                            <TextBlock Text="{Binding FolderPath}" Foreground="Gray" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                                <ComboBox SelectedIndex="{Binding ModeIndex}" Width="90" Margin="8,0,0,0">
                                                    <ComboBoxItem Content="Proxy"/>
                                                    <ComboBoxItem Content="Direct"/>
                                                </ComboBox>
                                                <Button Content="✕" FontSize="10" Padding="4,0" Margin="8,0,0,0"
                                                        Click="OnRemoveBundleClicked" Tag="{Binding}"/>
                                            </StackPanel>
                                            <TextBlock Text="Executables (matched by folder at connect time):"
                                                       FontSize="11" Foreground="Gray" Margin="0,6,0,2"/>
                                            <ItemsControl ItemsSource="{Binding Exes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" Margin="8,0,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <!-- Status + controls -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,4,0,8" TextWrapping="Wrap"
                   Text="Status: Stopped" Foreground="Gray"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StartButton" Content="START" Padding="16,4" Margin="0,0,8,0"
                    IsDefault="True" Click="OnStartClicked"/>
            <Button x:Name="StopButton" Content="STOP" Padding="16,4" IsEnabled="False"
                    Click="OnStopClicked"/>
        </StackPanel>

        <!-- Debug / Logs panel: bounded, near-real-time ferry events.
             The engine trace sink appends here; the log survives Refresh and
             is non-blocking (bounded ring buffer + batched UI drain). -->
        <Expander Grid.Row="4" Margin="0,12,0,0" Header="Debug / Logs" IsExpanded="True">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Copy log" Padding="10,2" Margin="0,0,6,0" Click="OnCopyLogClicked"/>
                    <Button Content="Clear" Padding="10,2" Click="OnClearLogClicked"/>
                    <TextBlock Text="(bounded: last 2000 lines)" Foreground="Gray" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="DebugLogList" Grid.Row="1" Height="180" BorderThickness="1"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="80"
                                            DisplayMemberBinding="{Binding Timestamp}"/>
                            <GridViewColumn Header="Level" Width="50"
                                            DisplayMemberBinding="{Binding Level}"/>
                            <GridViewColumn Header="Message" Width="540"
                                            DisplayMemberBinding="{Binding Message}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Expander>
    </Grid>
</Window>
