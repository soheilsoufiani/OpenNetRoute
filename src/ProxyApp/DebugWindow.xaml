<Window x:Class="ProxyApp.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyProxy — Debug Log" Height="600" Width="900"
        MinHeight="400" MinWidth="600">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Copy log" Padding="12,4" Margin="0,0,8,0" Click="OnCopyClicked"/>
            <Button Content="Clear" Padding="12,4" Click="OnClearClicked"/>
            <TextBlock Text="(bounded: last 2000 lines; updates in near-real-time)"
                       Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Monospace, plain-text log. The text is appended as lines so the
             whole log can be copied verbatim as plain text. -->
        <TextBox x:Name="LogTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 FontFamily="Consolas, Courier New, monospace"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="#FF1E1E1E"
                 Foreground="#FFDCDCDC"
                 AcceptsReturn="True"/>
    </Grid>
</Window>
