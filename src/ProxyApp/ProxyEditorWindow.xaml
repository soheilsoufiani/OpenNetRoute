<Window x:Class="ProxyApp.ProxyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy Profile" Icon="/Assets/app.ico" Height="330" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <!-- Same themed dictionary as the main window: implicit TextBox/PasswordBox/
         Button styles, FieldLabel/Hint, and the brush tokens ThemeApplier swaps
         for the light/dark palettes. NoResize + ShowInTaskbar=False keeps this a
         fixed-size dialog (no maximize/minimize chrome). -->
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Modern.xaml"/>
    </Window.Resources>

    <Grid Background="{DynamicResource BgWindowBrush}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource FieldLabel}" Margin="0,0,8,6"/>
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                 ToolTip="Optional — defaults to host:port"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Style="{StaticResource FieldLabel}" Margin="0,0,8,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="SOCKS5 (RFC 1928)" IsReadOnly="True" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Host:" Style="{StaticResource FieldLabel}" Margin="0,0,8,6"/>
        <TextBox x:Name="HostBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Port:" Style="{StaticResource FieldLabel}" Margin="0,0,8,6"/>
        <TextBox x:Name="PortBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Text="1080"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Username:" Style="{StaticResource FieldLabel}" Margin="0,0,8,6"/>
        <TextBox x:Name="UsernameBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Password:" Style="{StaticResource FieldLabel}" Margin="0,0,8,6"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"/>

        <!-- Result line + buttons. OK carries the accent style used by the main
             window's primary action; Test/Cancel stay quiet. -->
        <TextBlock x:Name="ResultText" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                   Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Text=""/>
        <StackPanel Grid.Row="7" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestButton" Content="Test" MinWidth="86" Margin="0,0,8,0" Click="OnTestClicked"/>
            <Button Content="OK" MinWidth="86" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOkClicked"/>
            <Button Content="Cancel" MinWidth="86" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
