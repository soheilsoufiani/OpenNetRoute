<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF application shell. UI only: main window, proxy configuration UI,
       process selection UI, rules UI, start/stop controls, status, logs, tray.
       Must NOT contain networking, WinDivert, or SOCKS5 implementation.
       The ProxyApp.WinDivert reference exists for COMPOSITION ONLY: the app
       constructs ProxyEngine (the public host) via its interface and never
       touches WinDivert/SOCKS5/packet types directly. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Dependency justification (AGENTS.md rule 3): Windows Forms is a
         first-party framework assembly (MIT, ships with Windows/.NET),
         required ONLY for System.Windows.Forms.NotifyIcon/ContextMenuStrip
         in TrayIconController.cs — the notification-area icon has no WPF
         equivalent. All tray code stays isolated in that single file; no
         other WinForms surface is used. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003: the WinForms analyzer wants DPI configured via
         Application.SetHighDpiMode, which applies to WinForms-only apps. This
         is a WPF app whose DPI behavior comes from app.manifest; WinForms is
         used solely for the tray NotifyIcon inside the WPF message loop, so
         the manifest settings must stay. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Windows Forms implicit usings (System.Windows.Forms,
         System.Drawing) would ambiguize common WPF names (Button, Clipboard,
         MessageBox, ...) in every other file of this project.
         TrayIconController.cs imports both namespaces explicitly instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded window icon (loaded via pack URI by every Window's Icon
         attribute). Asset copied from /icons/ico_pack_256x256_icon.ico, which
         carries all sizes 16–256 as frames of a single multi-size file. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProxyApp.Core\ProxyApp.Core.csproj" />
    <ProjectReference Include="..\ProxyApp.WinDivert\ProxyApp.WinDivert.csproj" />
  </ItemGroup>

</Project>