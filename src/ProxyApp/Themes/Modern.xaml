<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Open NetRoute modern theme (v1). Tokens below are DEFAULTS so first paint is
        sane; ThemeApplier swaps them at runtime per light/dark preference.
        All consumption uses DynamicResource so live switches propagate.

        ── HOW THE ANIMATIONS WORK ──
        Hover / press / selection transitions are done with layered PAINT-ONLY
        borders whose Opacity is animated (EnterActions / ExitActions on the state
        trigger), NOT with ColorAnimation on the brushes. Reason: every tint here
        is a DynamicResource token that ThemeApplier swaps at runtime per theme —
        a ColorAnimation would WRITE a frozen color and never unbind, so a live
        theme switch would stop propagating. Opacity multiplies the live brush,
        so the animation stays theme-agnostic and the tokens stay dynamic.

        Layer conventions used throughout:
        • tints are exact interior replicas: Margin = the chrome's border
          thickness, CornerRadius = outer radius minus that thickness;
        • tints are IsHitTestVisible=False so events pass through to the chrome;
        • tints sit UNDER the content (z-order) exactly like the old
          Background-it-replaced sat under the content;
        • hover eases in FAST and out SLOWER (usually ~0.1 s in, ~0.2 s out) —
          the standard asymmetry that reads as responsive rather than laggy;
        • press dips the chrome's scale slightly and springs back slower than
          it depressed, and the PressLayer adds one more step of darkening on
          top of the hover tint (as if the surface yields).
    -->
    <SolidColorBrush x:Key="BgWindowBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E1E1E1"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
    <SolidColorBrush x:Key="HoverTintBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#180078D7"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="#1FFFFFFF"/>
    <!-- Sliding segmented tab strip (TabSlider + FlatTabs template). The
         near-black track and its gray handle are deliberate constants faithful
         to the ported demo — they anchor the strip in BOTH palettes; the muted
         labels are white-based because they always sit on that dark track. -->
    <SolidColorBrush x:Key="TabTrackBrush" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="TabHandleBrush" Color="#535353"/>
    <SolidColorBrush x:Key="TabTextMutedBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D5D5E0"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="InputFocusBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E9E44"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D13438"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>

    <!-- Card container: soft surface, rounded corners, quiet border. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Padding" Value="16,14,16,14"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>


    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Quiet modern button: flat, rounded, hover tint, subtle border.
         Hover and press are animated tint layers; press additionally dips
         the chrome's scale (one scaling root shrinks border + tints + content
         together — scaling only the chrome would leave the tint layers at
         full size during the dip). -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Background=Transparent keeps the whole rect
                         hit-testable; the tint layers are
                         IsHitTestVisible=False so clicks still land on the
                         control itself. Tints inset by the chrome's 1px
                         border (Margin) and radius 7 = 8 - 1 replicate the
                         interior exactly. -->
                    <Grid x:Name="ScaleRoot"
                          Background="Transparent"
                          RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale"/>
                        </Grid.RenderTransform>
                        <Border x:Name="HoverLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource HoverTintBrush}"
                                Margin="1" CornerRadius="7" Opacity="0"/>
                        <Border x:Name="PressLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource TabSelectedBrush}"
                                Margin="1" CornerRadius="7" Opacity="0"/>
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: tint eases in fast, out slower. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.11">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Press: quick dip + one darker step over the hover
                             tint; release reverses a touch slower than it
                             depressed. Pressing implies hovering, so the
                             hover layer stays at full opacity underneath and
                             the press tint stacks on top of it. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action (START): filled accent, high emphasis.
         Hover fades the chrome's opacity (the same 0.88 step the flat style
         used, now eased) and press dips the scale; the filled surface needs
         no tint layers because the chrome itself carries the full color. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ScaleRoot"
                          Background="Transparent"
                          RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Chrome"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chrome"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.88" Duration="0:0:0.11">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chrome"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs: dark-mode fields with rounded borders and an accent focus ring. -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InputTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource InputFocusBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource InputFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InputTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource InputFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1">
                            <Path x:Name="Check" Data="M3,8.5 L7,12.5 L14,3.5"
                                  Stroke="#FFFFFF" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource InputFocusBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource InputFocusBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource InputFocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: fully templated so the field AND its dropdown follow the
         dark theme (never the native white popup). -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1" CornerRadius="6">
                                        <Path Data="M0,0 L4,4 L8,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,1,10,0"
                                              Stroke="{DynamicResource InputTextBrush}"
                                              StrokeThickness="1.6"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource InputFocusBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide">
                            <Border Background="{DynamicResource PopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                                    Padding="0,4" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Dropdown rows: hover and select eases via tint layers exactly like
         the app's buttons — a choice highlighted while keyboard-browsing
         slides its tint on instead of popping. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Margin="4,1" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource HoverTintBrush}"
                                CornerRadius="4" Opacity="0"/>
                        <Border x:Name="SelectLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource TabSelectedBrush}"
                                CornerRadius="4" Opacity="0"/>
                        <Border Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Folder-bundle chip: rounded box with the bundle name centered. On hover
         a compact icon toolbar (info / enable-toggle / remove) overlays the
         right side. A plain Border — no Expander state to fail; clicking the
         chip (or ⓘ) opens the BundleInfoWindow popup. -->
    <Style x:Key="BundleChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Borderless icon button used inside bundle chips (info / toggle / remove). -->
    <Style x:Key="ChipIcon" TargetType="Button">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <!-- Idle: muted (light gray in dark mode) so row actions don't compete
             with content; hover: full-strength text color (white in dark mode).
             Theme-aware: in light mode the hover glyph goes near-black because
             white would vanish on the faint dark hover tint. -->
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="HoverLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource HoverTintBrush}"
                                CornerRadius="6" Opacity="0"/>
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: the chip's round tint fades in behind the
                             glyph; the FOREGROUND swap stays a setter (it is a
                             DynamicResource token, not animatable without
                             freezing it). -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Press: quick fade of the whole chip; release
                             restores it slightly slower. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.7" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- START/STOP state toggle: green while disconnected, red while running.
         Content switches with IsChecked; engine wiring is code-behind.
         BOTH color states are animated: the green base is the chrome's
         permanent fill and the RUNNING state only fades the danger color in
         over it, so START→STOP and STOP→START both glide instead of
         snapping when the engine toggles. -->
    <Style x:Key="StateToggleButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Content" Value="START"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- The content presenter is a SIBLING of the chrome (with
                         the chrome's Padding as its margin) so it can sit ABOVE
                         the danger layer: the layer must cover the fill but
                         never wash the white label. -->
                    <Grid x:Name="ScaleRoot"
                          Background="Transparent"
                          RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Chrome"
                                Background="{DynamicResource SuccessBrush}"
                                CornerRadius="8"/>
                        <Border x:Name="DangerLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource DangerBrush}"
                                CornerRadius="8"
                                Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Engine running: danger tint fades over the green
                             base; stopping reverses even slower — a red that
                             appeared instantly would read as a flicker. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DangerLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DangerLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.28"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleRoot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.9" Duration="0:0:0.11"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleRoot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="STOP"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Flat pill tabs -->
    <Style x:Key="FlatTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Never a keyboard focus sink: a focusable TabControl ends up
             holding keyboard focus (e.g. after window deactivate/reactivate)
             and drew a dotted rectangle spanning the entire tab content, and
             it wastes a Tab stop. TabItems stay focusable and navigable. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Sliding segmented tab strip (ported from the CSS/JS
                             demo): one dark rounded track, equal-width slots,
                             and a lighter handle that GLIDES under the newly
                             selected tab on every switch. TabSlider (attached
                             behavior in code) owns the geometry and the 300 ms
                             translate animation; the PART_ names are its
                             contract (resolved via Template.FindName). -->
                        <Border Grid.Row="0" x:Name="PART_SlideTrack"
                                Background="{DynamicResource TabTrackBrush}"
                                CornerRadius="8" Padding="4" Margin="0,2,0,10">
                            <!-- Clip so a mid-flight handle never spills out
                                 of the rounded track (demo: overflow hidden). -->
                            <Grid ClipToBounds="True">
                                <!-- The sliding pill. Sized and translated by
                                     TabSlider in code: width = slot * 0.94,
                                     height = 80% of the strip (10% bands
                                     top/bottom) — i.e. the demo's
                                     scale(0.94, 0.8) baked into geometry. -->
                                <Border x:Name="PART_SlideHandle"
                                        Background="{DynamicResource TabHandleBrush}"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        SnapsToDevicePixels="True"/>
                                <!-- Equal-width slots. Columns are set by
                                     TabSlider: UniformGrid's auto arrange would
                                     go grid-shaped (rows!) for non-square item
                                     counts, so an explicit count is required. -->
                                <UniformGrid x:Name="PART_SlideHost" IsItemsHost="True"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Tabs inside the segmented strip: the sliding handle UNDER the labels
         is the selection indicator, so there is deliberately NO per-tab
         selection fill anymore. Labels center in their equal-width slot; a
         faint white wash eases in on hover (the strip is dark in both
         palettes, so the wash and the lightening label are white-based).
         The content-panel fade/slide on Switch stays with TabContentAnimator,
         which lives in its own visual subtree (the selected content host). -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TabTextMutedBrush}"/>
        <!-- NO Cursor setter here: tab content is a *logical* child of its
             TabItem, and Cursor is an inheritable property — a Hand cursor on
             the TabItem silently flowed into the whole tab content area (the
             arrow turned into a hand over labels, cards, list rows — places
             where clicking does nothing). The strip's own Hand cursor lives
             on the pill's root grid inside the template below, which the tab
             content is NOT a child of, so it cannot leak. -->
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent" Cursor="Hand"
                          SnapsToDevicePixels="True">
                        <Border x:Name="HoverLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource TabHoverBrush}"
                                CornerRadius="6" Opacity="0"/>
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="16,8"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Data rows: airy heights, clean headers, quiet separators. The hover
         and selection seeps are the same tint-layer pattern as the buttons:
         the old Background setters snapped, now each fades. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Margin="8,7,8,7"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" FontSize="11.5"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ListRow" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource HoverTintBrush}"
                                CornerRadius="4" Opacity="0"/>
                        <Border x:Name="SelectLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource TabSelectedBrush}"
                                CornerRadius="4" Opacity="0"/>
                        <Border Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DataList" TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListRow}"/>
    </Style>

    <!-- ============ Scrollbars (Windows 11 style with arrows) ============
         Thin 14px bar, transparent track, rounded pill thumb that lightens
         on hover/drag; chevron arrow buttons at both ends for line scrolling;
         clicking the empty track still page-scrolls. Thickness is set per
         orientation (never Height on a vertical bar — that shrinks its
         length). Implicit style — applies to every ScrollViewer in the app.
         (The thumb's hover stays a snap — the two gray tokens are so close
         that an animated cross-fade would be invisible; the arrows animate
         the same faint tint as the buttons above.) -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollArrowButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid>
                        <Border x:Name="HoverLayer"
                                IsHitTestVisible="False"
                                Background="{DynamicResource HoverTintBrush}"
                                CornerRadius="3" Opacity="0"/>
                        <Border x:Name="ArrowB" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbB"
                            Background="{DynamicResource ScrollThumbBrush}"
                            CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbB" Property="Background"
                                    Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbB" Property="Background"
                                    Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Vertical (default orientation) -->
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <RepeatButton Grid.Row="0"
                                      Style="{StaticResource ScrollArrowButton}"
                                      Command="{x:Static ScrollBar.LineUpCommand}">
                            <Path Width="8" Height="5" Data="M 0 4.5 L 4 0.5 L 8 4.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </RepeatButton>
                        <Track x:Name="PART_Track" Grid.Row="1"
                               Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}"
                                              Command="{x:Static ScrollBar.PageUpCommand}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}"
                                              Command="{x:Static ScrollBar.PageDownCommand}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ThumbHost"
                                       Style="{StaticResource ScrollBarThumb}"
                                       MinHeight="24"/>
                            </Track.Thumb>
                        </Track>
                        <RepeatButton Grid.Row="2"
                                      Style="{StaticResource ScrollArrowButton}"
                                      Command="{x:Static ScrollBar.LineDownCommand}">
                            <Path Width="8" Height="5" Data="M 0 0.5 L 4 4.5 L 8 0.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="14"/>
                <Setter Property="MinWidth" Value="14"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="14"/>
                <Setter Property="MinHeight" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <RepeatButton Grid.Column="0"
                                              Style="{StaticResource ScrollArrowButton}"
                                              Command="{x:Static ScrollBar.LineLeftCommand}">
                                    <Path Width="5" Height="8" Data="M 4.5 0 L 0.5 4 L 4.5 8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </RepeatButton>
                                <Track x:Name="PART_Track" Grid.Column="1"
                                       Orientation="Horizontal" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                      Command="{x:Static ScrollBar.PageLeftCommand}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                      Command="{x:Static ScrollBar.PageRightCommand}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="ThumbHost"
                                               Style="{StaticResource ScrollBarThumb}"
                                               MinWidth="24"/>
                                    </Track.Thumb>
                                </Track>
                                <RepeatButton Grid.Column="2"
                                              Style="{StaticResource ScrollArrowButton}"
                                              Command="{x:Static ScrollBar.LineRightCommand}">
                                    <Path Width="5" Height="8" Data="M 0.5 0 L 4.5 4 L 0.5 8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </RepeatButton>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="ThumbHost" Property="Margin" Value="0,2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
