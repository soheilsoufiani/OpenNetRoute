<Window x:Class="ProxyApp.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open NetRoute — Session Log" Icon="/Assets/app.ico" Height="640" Width="980"
        MinHeight="420" MinWidth="720" WindowStartupLocation="CenterOwner"
        FontSize="12" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Modern.xaml"/>
    </Window.Resources>

    <Grid Background="{DynamicResource BgWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Content="Copy Logs" MinWidth="96"
                            ToolTip="Copy the ENTIRE session log to the clipboard (to copy only part, select the text above and press Ctrl+C)"
                            Click="OnCopyClicked"/>
                    <Button x:Name="ClearButton" Content="Clear Logs" MinWidth="96" Margin="8,0,0,0"
                            ToolTip="Clear the in-memory session log"
                            Click="OnClearClicked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Session Log"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="12,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Live log view: a single read-only TEXT view over the shared session
             log. Unlike the old per-row list, the whole content is one text
             block — the operator can select any range (drag / double-click /
             Ctrl+A) and copy just that part with Ctrl+C. Severity tinting is
             applied per paragraph (red ERR, amber WARN). -->
        <RichTextBox x:Name="LogView" Grid.Row="1"
                     Margin="14,10,14,4"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     IsUndoEnabled="False" AcceptsReturn="True" AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Consolas" FontSize="12"
                     Background="{DynamicResource InputBackgroundBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     BorderThickness="1"
                     Padding="8,6"/>

        <!-- Status strip -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock Style="{StaticResource Hint}"
                       Text="In-memory session log · captures everything since application launch · updates live · bounded to the last 2000 lines"/>
        </Border>
    </Grid>
</Window>