<Window x:Class="ProxyApp.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyProxy — Session Log" Height="640" Width="980"
        MinHeight="420" MinWidth="720" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Modern.xaml"/>
    </Window.Resources>

    <Grid Background="{DynamicResource BgWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Content="Copy Logs" MinWidth="96"
                            ToolTip="Copy the visible session log to the clipboard"
                            Click="OnCopyClicked"/>
                    <Button x:Name="ClearButton" Content="Clear Logs" MinWidth="96" Margin="8,0,0,0"
                            ToolTip="Clear the in-memory session log"
                            Click="OnClearClicked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Session Log"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="12,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Live log view: binds the shared session collection; severity-tinted
             rows keep the ListRow hover/select template via BasedOn. -->
        <ListView x:Name="LogList" Grid.Row="1" Style="{StaticResource DataList}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Margin="14,10,14,4">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="ERR">
                            <Setter Property="Foreground" Value="#F26B6B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                            <Setter Property="Foreground" Value="#F26B6B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                            <Setter Property="Foreground" Value="#E0A340"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="TIME" Width="92"
                                    DisplayMemberBinding="{Binding Timestamp}"/>
                    <GridViewColumn Header="LEVEL" Width="64"
                                    DisplayMemberBinding="{Binding Level}"/>
                    <GridViewColumn Header="MESSAGE" Width="760"
                                    DisplayMemberBinding="{Binding Message}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status strip -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock Style="{StaticResource Hint}"
                       Text="In-memory session log · captures everything since application launch · updates live · bounded to the last 2000 lines"/>
        </Border>
    </Grid>
</Window>